# Bebop Market Maker 配置
# 复制此文件为 .env 并填写实际值

# 链 ID (56 = BSC Mainnet)
CHAIN_ID=56

# 私钥 (不带 0x 前缀或带 0x 前缀都可以)
PRIVATE_KEY=your_private_key_here

# Bebop Market Maker 名称
MARKET_MAKER=your_market_maker_name

# Bebop Authorization Token
AUTHORIZATION=your_authorization_token

# 自执行模式 (true/false)
SELF_EXECUTION=true

# 价格点差 (0.005 = 0.5%)
PRICE_SPREAD=0.005

# API 端口
API_PORT=:8080

# API Key (可选，用于保护价格 API)
PRICE_API_KEY=
